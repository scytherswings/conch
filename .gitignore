# --- local secrets -----------------------------------------------------------
.dev.vars
.env
*.env
secrets.env

# --- private docs ---------------------------------------------------------------
# Public docs live in docs/ and are tracked. Private design records, plans,
# specs, runbooks, burn-in notes and decisions live in docs/private/ and are
# never committed. Keep real hostnames and credential locations out of the
# public tree entirely.
/docs/private/

