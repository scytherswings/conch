.wrangler/
node_modules/
.venv/
venv/
__pycache__/
*.log
coverage.out
coverage/
*.test
dist/
bin/

# the built conch binary; built from source, never committed
/conch

# --- editor / OS ---------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- local tool state ---------------------------------------------------------
.claude/
.ruby-lsp/

# --- agent / worktree state ---------------------------------------------------
.worktrees/
.superpowers/
